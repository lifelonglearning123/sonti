# ─── App ───────────────────────────────────────────────────────────────────
# Base URL of the app (used for OAuth redirects). e.g. http://localhost:3001
NEXTAUTH_URL=http://localhost:3001

# Secret used to derive the at-rest encryption key for stored GHL tokens.
# Generate with: openssl rand -base64 32
# (TOKEN_ENCRYPTION_KEY takes precedence; NEXTAUTH_SECRET is used as a fallback.)
TOKEN_ENCRYPTION_KEY=
NEXTAUTH_SECRET=

# ─── Supabase ──────────────────────────────────────────────────────────────
# Project URL and keys from Supabase dashboard → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key — server-only, used for super-admin provisioning. Keep secret.
SUPABASE_SERVICE_ROLE_KEY=

# ─── Database (Supabase Postgres) ────────────────────────────────────────────
# Runtime connection via the transaction pooler (port 6543) for serverless/Vercel.
DATABASE_URL=postgresql://postgres.YOUR-REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
# Direct connection (port 5432) used only for migrations (prisma migrate).
DIRECT_URL=postgresql://postgres.YOUR-REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# ─── GoHighLevel agency connection ───────────────────────────────────────────
# Two ways to connect the agency (you can use either, or both):
#
# Option A — Private Integration Token (PIT), simplest, no marketplace app:
#   Agency-level PIT (creates/lists sub-accounts). Create in GHL → Agency Settings
#   → Private Integrations. Each sub-account also needs its OWN location PIT (pasted
#   per workspace in the app) for CRM data.
GHL_AGENCY_API_TOKEN=pit-...
GHL_COMPANY_ID=
#
# Option B — OAuth (GHL marketplace app). Lets the app mint per-sub-account tokens
#   automatically (no per-location PIT). Set these, then super-admin clicks
#   "Connect via OAuth" in /superadmin.
GHL_OAUTH_CLIENT_ID=
GHL_OAUTH_CLIENT_SECRET=
GHL_OAUTH_REDIRECT_URI=http://localhost:3001/api/ghl/oauth/callback
# Optional overrides:
# GHL_OAUTH_AUTHORIZE_URL=https://marketplace.gohighlevel.com/oauth/chooselocation
# GHL_OAUTH_SCOPE="locations.readonly locations.write ..."

# ─── Super-admin bootstrap (used by prisma/seed.ts) ──────────────────────────
SUPERADMIN_EMAIL=admin@example.com
SUPERADMIN_PASSWORD=change-me-strong-password
