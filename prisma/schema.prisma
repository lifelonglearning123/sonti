generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum PlatformRole {
  user
  superadmin
}

enum OrgRole {
  owner
  admin
  member
}

enum PlanTier {
  free
  starter
  pro
}

/// A tenant. One agency = one Organization.
model Organization {
  id           String   @id @default(uuid())
  name         String
  slug         String   @unique
  plan         PlanTier @default(free)
  isActive     Boolean  @default(true)
  brandName    String?
  brandColor   String?
  brandLogoUrl String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships    Membership[]
  locations      OrgLocation[]
  locationTokens GhlLocationToken[]
}

/// Single platform-wide GHL agency OAuth connection (one row, id = "singleton").
/// Optional alternative to the env agency PIT. When present, per-sub-account
/// location tokens are minted from it on demand. Tokens encrypted at rest.
model AgencyConnection {
  id           String   @id @default("singleton")
  companyId    String
  agencyName   String?
  accessToken  String
  refreshToken String
  scope        String?
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

/// 1:1 with Supabase auth.users. `id` == auth.users.id (the JWT `sub`).
/// Owns platform-level identity (super-admin) and is the link target for memberships.
model Profile {
  id           String       @id
  email        String       @unique
  fullName     String?
  platformRole PlatformRole @default(user)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  memberships Membership[]
}

/// A profile's role within a specific organization.
model Membership {
  id             String   @id @default(uuid())
  profileId      String
  organizationId String
  role           OrgRole  @default(member)
  /// GHL sub-account this member is scoped to (optional; owners/admins switch freely).
  ghlLocationId  String?
  createdAt      DateTime @default(now())

  profile      Profile      @relation(fields: [profileId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([profileId, organizationId])
  @@index([organizationId])
}

/// A GHL sub-account (location) that belongs to an organization.
/// `apiToken` is that sub-account's own location-level Private Integration Token
/// (encrypted). When set, it's used directly for the sub-account's CRM data;
/// otherwise a location token is minted from the agency OAuth connection.
model OrgLocation {
  id             String   @id @default(uuid())
  organizationId String
  ghlLocationId  String
  name           String?
  apiToken       String?
  createdAt      DateTime @default(now())

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  tokens       GhlLocationToken[]

  @@unique([organizationId, ghlLocationId])
  @@index([organizationId])
}

/// Cache of location access tokens MINTED from the agency OAuth connection
/// (only used in OAuth mode; PIT mode reads OrgLocation.apiToken directly).
model GhlLocationToken {
  id             String   @id @default(uuid())
  organizationId String
  ghlLocationId  String
  accessToken    String
  refreshToken   String?
  companyId      String?
  expiresAt      DateTime
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  orgLocation  OrgLocation? @relation(fields: [organizationId, ghlLocationId], references: [organizationId, ghlLocationId])

  @@unique([organizationId, ghlLocationId])
  @@index([organizationId])
}
